# Backend API base URL
API_BASE_URL=http://localhost:3000

# Yandex Maps JS API key — required for the /clinics/map view.
# Get a free key at https://developer.tech.yandex.ru/services (JavaScript API and HTTP Geocoder).
NUXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Google OAuth Client ID — required for the "Google orqali kirish" button on /login.
# Create one at https://console.cloud.google.com/apis/credentials
# (OAuth client ID -> Web application -> Authorized JavaScript origins: this
# app's URL, e.g. http://localhost:3210). Leave unset to hide the button.
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
